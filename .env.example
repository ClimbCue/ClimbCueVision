# 可选：启用 OpenAI-compatible Chat Completions 服务。
# BASE_URL 应包含服务的 API 前缀，如 http://127.0.0.1:11434/v1
# RAG 配置在启动前 export；指导模块会读取项目 .env，环境变量优先，凭证不发送给浏览器。
CLIMBCUE_LLM_BASE_URL=
CLIMBCUE_LLM_MODEL=
CLIMBCUE_LLM_API_KEY=

# 可选：下一步指导。未设置时复用 CLIMBCUE_LLM_*，凭证仅保存在服务端。
# JoyMaas 示例 BASE_URL=https://modelservice.jdcloud.com/v1
# 模型需在账号下开通；示例可选 Qwen3.6-35B-A3B，实际可用性以账号为准。
CLIMBCUE_COACH_BASE_URL=https://modelservice.jdcloud.com/v1
CLIMBCUE_COACH_MODEL=Qwen3.6-35B-A3B
CLIMBCUE_COACH_API_KEY=
# 强制 CPU 对照时设置 CLIMBCUE_MODEL_DEVICE=cpu；默认自动使用 MPS。
